    "ContentName_The Goblet": "The Goblet",
    "Instancecontenttextdata_4017_Text": "Impressive! Now it is my turn!",
    "Instancecontenttextdata_18605_Text": "Tempest, surge!",
    "Instancecontenttextdata_18612_Text": "Roar! Writhe! Rage!",
    "Instancecontenttextdata_18613_Text": "You are stronger than I dared to hope.",
    "Instancecontenttextdata_32907_Text": "Come, we shall see if you can finish what you have started.",
    "Instancecontenttextdata_38114_Text": "Chronicles of eld... Recall the cruelty of merciless storms!",
    "Instancecontenttextdata_40705_Text": "And they're down! Is it over already!?",
    "Instancecontenttextdata_40706_Text": "They're back on their feet! What grit!",
    "Instancecontenttextdata_40712_Text": "It's all over...until next time!",
    "Instancecontenttextdata_42104_Text": "Were you to die here, it would save me trouble later.",
    "Instancecontenttextdata_42105_Text": "Still alive. How unfortunate. ",
    "Instancecontenttextdata_42106_Text": "I'm beginning to understand how you were able to defeat Queen Eternal.",
